# Variables de entorno de la API. Copiá este archivo como .env (que git ignora) y completalo.
# DB_PASSWORD es obligatoria: no tiene valor por defecto en el código.
# El resto son opcionales: si faltan, se usan los valores de ejemplo de abajo (ver app.module.ts).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar-por-una-clave-propia
DB_NAME=pc_prearmadas
PORT=3000
